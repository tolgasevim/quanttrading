# Copy to .env (never commit .env). All app settings use the QT_ prefix; see backend/src/quant/config.py.

POSTGRES_PASSWORD=change-me-to-a-long-random-string

# Keep true when serving over HTTPS (e.g. `tailscale serve --bg 3000`). Set false only when you
# open the app over plain http://localhost during local testing.
QT_COOKIE_SECURE=true

# Data providers, tried in order (PRD §8).
QT_PRICE_PROVIDERS=["yahoo","stooq"]
QT_FX_PROVIDER=ecb

# Schedules (cron, Europe/Berlin).
QT_PRICES_CRON=30 22 * * mon-fri
QT_FX_CRON=30 16 * * mon-fri
QT_BACKFILL_DAYS=400

WEB_PORT=3000
