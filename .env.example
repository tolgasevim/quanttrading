# Copy to .env (never commit .env). All app settings use the QT_ prefix; see backend/src/quant/config.py.

# Any characters work; generate one with e.g. `openssl rand -base64 32`. If it contains a `$`,
# wrap it in single quotes so Docker Compose doesn't treat it as a variable.
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# Keep true when serving over HTTPS (e.g. `tailscale serve --bg 3000`). Set false only when you
# open the app over plain http://localhost during local testing.
QT_COOKIE_SECURE=true

# Data providers, tried in order (PRD §8).
# A list is a comma list (yahoo,stooq) or JSON (["yahoo","stooq"]).
QT_PRICE_PROVIDERS=yahoo,stooq,coingecko
QT_FX_PROVIDER=ecb
# CoinGecko prices crypto in euros. It works without a key; a free demo key raises the limit.
# Leave coingecko out of the list above to switch crypto prices off.
# QT_COINGECKO_API_KEY=
# Lookup of a ticker from an ISIN, tried in order. The OpenFIGI key is optional and free
# (https://www.openfigi.com/api); it raises the rate limit.
QT_ISIN_RESOLVERS=yahoo,openfigi
# QT_OPENFIGI_API_KEY=
# Ask again about an ISIN no lookup knew after this many days.
QT_ISIN_RETRY_DAYS=30

# Schedules (cron, Europe/Berlin).
QT_PRICES_CRON=30 22 * * mon-fri
QT_FX_CRON=30 16 * * mon-fri
QT_MAPPING_CRON=0 22 * * mon-fri
QT_BACKFILL_DAYS=400

WEB_PORT=3000
